{
  "name": "@depot/sdk-node",
  "version": "2.3.0",
  "description": "Node SDK for the Depot API",
  "keywords": [
    "depot",
    "docker",
    "sdk"
  ],
  "homepage": "https://github.com/depot/sdk-node",
  "license": "MIT",
  "author": "Jacob Gillespie <jacobwgillespie@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/depot/sdk-node.git"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --format cjs --dts",
    "clean": "rm -rf dist",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "generate": "buf generate buf.build/depot/api",
    "lint": "oxlint --deny-warnings .",
    "package:check": "pnpm run build && node .github/scripts/verify-package.mjs",
    "prepack": "pnpm run build",
    "test": "pnpm run build && vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "publint": "0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.9.1"
}
